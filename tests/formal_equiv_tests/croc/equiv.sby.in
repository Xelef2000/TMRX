# Formal equivalence check for croc_soc after TMRX LogicTMR expansion.
# The TMRX transformation keeps the top-level interface stable, so the miter
# directly compares gold_mod and gate_mod port-for-port.

[options]
mode prove

[engines]
abc pdr

[script]
plugin -i @SLANG_SO@
plugin -i @TMRX_SO@

# -------------------------------------------------------------------------
# Gold: original RTL flattened to generic cells.
# -------------------------------------------------------------------------
# tc_sram_impl_stub.sv must be read before the flist so slang can resolve
# implicit port connections (.clk_i, / .rst_ni,) inside croc_domain.sv.
# The real tc_sram_impl.sv (IHP SRAM macros) is excluded from the flist.
read_slang --top croc_soc tc_sram_impl_stub.sv @SG13G2_STUBS@ -f @CROC_FLIST_ABS@ \
        --compat-mode --keep-hierarchy \
        --allow-use-before-declare
hierarchy -top croc_soc

proc; opt; flatten
opt_clean -purge
design -save gold

# -------------------------------------------------------------------------
# Gate: apply TMRX, then flatten.
# -------------------------------------------------------------------------
design -reset
read_slang --top croc_soc tc_sram_impl_stub.sv @SG13G2_STUBS@ -f @CROC_FLIST_ABS@ \
        --compat-mode --keep-hierarchy \
        --allow-use-before-declare
hierarchy -top croc_soc

proc; opt
tmrx_mark
tmrx -c @TOML_FILE@
select -assert-min 1 */t:tmrx_voter_*
opt -noff
flatten
opt_clean -purge
design -save gate

# -------------------------------------------------------------------------
# Merge and create equivalence miter.
# -------------------------------------------------------------------------
design -load gold
rename croc_soc gold_mod
design -copy-from gate *
rename croc_soc gate_mod

miter -equiv -make_assert -make_outputs gold_mod gate_mod miter
hierarchy -top miter
flatten
# Force all undefined (X) FF initial values to 0 in both gold and gate before
# clk2fflogic runs.  Without this, sby's prep pass replaces X init values with
# $anyseq free variables, allowing the formal engine to pick asymmetric initial
# states (e.g. gate.ff_a/b/c = 1 while gold.ff = 0) that create trivial
# counterexamples unrelated to TMR correctness.
setundef -zero -init
# Convert clocked FFs into formal transition logic so PDR can handle any
# derived clocks introduced by clock infrastructure in Croc.
clk2fflogic

[files]
@TOML_FILE@
@TC_SRAM_STUB@
